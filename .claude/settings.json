{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Bash(python herramientas/generar_cuenta_xml.py:*)",
      "Bash(python3 herramientas/generar_cuenta_xml.py:*)",
      "Read(./vault-patrones/**)",
      "Read(./vault-proyecto-*/**)",
      "Read(./contexto/**)",
      "Read(./memoria/**)",
      "Read(./schemas/**)",
      "Read(./Account/**)",
      "Read(./reportes/**)"
    ],
    "deny": [
      "Edit(./contexto/**)",
      "Write(./contexto/**)",
      "Bash(* > contexto/**)",
      "Bash(* >> contexto/**)",
      "Bash(Set-Content * contexto/**)",
      "Bash(Out-File * contexto/**)",
      "Bash(git push *)",
      "Bash(git clone *)",
      "Bash(gh repo create *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(sqlcmd *)",
      "Bash(osql *)",
      "Bash(bcp *)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./herramientas/**)",
      "Write(./herramientas/**)",
      "Edit(./schemas/**)",
      "Write(./schemas/**)",
      "Edit(./vault-patrones/**)",
      "Write(./vault-patrones/**)"
    ]
  }
}